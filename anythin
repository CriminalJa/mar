  const invite = document.getElementById('invite').value.trim();
  if (!username) return alert('enter username');
  const res = await fetch('/api/register', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ username, invite_code: invite || undefined }) });
