function generateInviteCode() { return uuidv4().split('-')[0]; }

// API endpoints
app.post('/api/register', (req, res) => {
  const { username, invite_code } = req.body || {};
  if (!username) return res.status(400).json({ error: 'username required' });
  const newInvite = generateInviteCode();
  const insert = db.prepare('INSERT INTO users (username, invite_code) VALUES (?, ?)');
  try {
    const info = insert.run(username, newInvite);
    const userId = info.lastInsertRowid;

    if (invite_code) {
      const ref = db.prepare('SELECT id FROM users WHERE invite_code = ?').get(invite_code);
      if (ref) {
        const refId = ref.id;
        db.prepare('UPDATE users SET referrer_id = ? WHERE id = ?').run(refId, userId);
        db.prepare('UPDATE users SET balance = balance + ? WHERE id = ?').run(10, refId);
      }
    }

    const user = db.prepare('SELECT id, username, invite_code, referrer_id, balance FROM users WHERE id = ?').get(userId);
    const inviteLink = \`\${req.protocol}://\${req.get('host')}/?invite=\${user.invite_code}\`;
    res.json({ user, inviteLink });
  } catch (e) {
    if (e && e.message && e.message.includes('UNIQUE')) return res.status(400).json({ error: 'username already taken' });
    console.error(e);
    res.status(500).json({ error: 'server error' });
  }
});

app.get('/api/user/:id', (req, res) => {
  const id = req.params.id;
  const user = db.prepare('SELECT id, username, invite_code, referrer_id, balance FROM users WHERE id = ?').get(id);
  if (!user) return res.status(404).json({ error: 'not found' });
  res.json({ user });
});

app.post('/api/create_ad_token', (req, res) => {
  const { user_id } = req.body || {};
  if (!user_id) return res.status(400).json({ error: 'user_id required' });
  const user = db.prepare('SELECT id FROM users WHERE id = ?').get(user_id);
  if (!user) return res.status(404).json({ error: 'user not found' });
  const token = uuidv4();
  const expiresAt = Math.floor(Date.now() / 1000) + 120; // 2 minutes
  db.prepare('INSERT INTO ad_tokens (token, user_id, expires_at, used) VALUES (?, ?, ?, 0)').run(token, user_id, expiresAt);
  res.json({ token, expires_at: expiresAt });
});

app.post('/api/redeem_ad_token', (req, res) => {
  const { user_id, token } = req.body || {};
  if (!user_id || !token) return res.status(400).json({ error: 'user_id and token required' });

  const row = db.prepare('SELECT token, user_id, used, expires_at FROM ad_tokens WHERE token = ?').get(token);
  if (!row) return res.status(400).json({ error: 'invalid token' });
  if (row.used) return res.status(400).json({ error: 'token already used' });
  if (row.user_id !== user_id) return res.status(400).json({ error: 'token does not belong to user' });
  const now = Math.floor(Date.now() / 1000);
  if (row.expires_at < now) return res.status(400).json({ error: 'token expired' });

  const credit = 2; // 2 naira
  const refShare = Math.floor(credit * 0.5); // 1 naira

  const tx = db.transaction(() => {
    db.prepare('UPDATE ad_tokens SET used = 1 WHERE token = ?').run(token);
    db.prepare('UPDATE users SET balance = balance + ? WHERE id = ?').run(credit, user_id);
    db.prepare('INSERT INTO ad_events (user_id, amount) VALUES (?, ?)').run(user_id, credit);
    const user = db.prepare('SELECT referrer_id FROM users WHERE id = ?').get(user_id);
    if (user && user.referrer_id) {
      db.prepare('UPDATE users SET balance = balance + ? WHERE id = ?').run(refShare, user.referrer_id);
    }
  });

  try {
    tx();
    const newBal = db.prepare('SELECT balance FROM users WHERE id = ?').get(user_id);
    res.json({ success: true, credited: credit, balance: newBal.balance });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: 'server error' });
  }
});

app.post('/api/request_withdrawal', (req, res) => {
  const { user_id, amount, details } = req.body || {};
  if (!user_id || !amount || !details) return res.status(400).json({ error: 'user_id, amount, details required' });
  const minWithdrawal = 500;
  if (amount < minWithdrawal) return res.status(400).json({ error: \`minimum withdrawal is \${minWithdrawal} naira\` });
  const user = db.prepare('SELECT balance FROM users WHERE id = ?').get(user_id);
  if (!user) return res.status(404).json({ error: 'user not found' });
  if (user.balance < amount) return res.status(400).json({ error: 'insufficient balance' });

  const tx = db.transaction(() => {
    db.prepare('UPDATE users SET balance = balance - ? WHERE id = ?').run(amount, user_id);
    db.prepare('INSERT INTO withdrawals (user_id, amount, details, status) VALUES (?, ?, ?, ?)').run(user_id, amount, details, 'pending');
  });

  try {
    tx();
    res.json({ success: true, message: 'withdrawal requested and is pending admin approval' });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: 'server error' });
  }
});

// Admin
app.post('/api/admin/login', async (req, res) => {
  const { pin } = req.body || {};
  if (!pin) return res.status(400).json({ error: 'pin required' });
  const match = await bcrypt.compare(pin, ADMIN_PIN_HASH);
  if (!match) return res.status(401).json({ error: 'invalid pin' });
  const token = jwt.sign({ admin: true }, ADMIN_JWT_SECRET, { expiresIn: '12h' });
  res.json({ token });
});

function verifyAdmin(req, res, next) {
  const auth = req.headers.authorization;
  if (!auth) return res.status(401).json({ error: 'missing authorization' });
  const parts = auth.split(' ');
  if (parts.length !== 2) return res.status(401).json({ error: 'invalid authorization' });
  const token = parts[1];
  try {
    const payload = jwt.verify(token, ADMIN_JWT_SECRET);
    if (payload && payload.admin) return next();
    return res.status(403).json({ error: 'forbidden' });
  } catch (e) {
    return res.status(401).json({ error: 'invalid token' });
  }
}

app.get('/api/admin/withdrawals', verifyAdmin, (req, res) => {
  const rows = db.prepare(\`
    SELECT w.id, w.user_id, u.username, w.amount, w.details, w.status, w.created_at
    FROM withdrawals w
    LEFT JOIN users u ON u.id = w.user_id
    ORDER BY w.created_at DESC
  \`).all();
  res.json({ withdrawals: rows });
});

app.post('/api/admin/withdrawals/:id/approve', verifyAdmin, (req, res) => {
  const id = req.params.id;
  const w = db.prepare('SELECT * FROM withdrawals WHERE id = ?').get(id);
  if (!w) return res.status(404).json({ error: 'not found' });
  if (w.status !== 'pending') return res.status(400).json({ error: 'can only approve pending withdrawals' });
  db.prepare('UPDATE withdrawals SET status = ? WHERE id = ?').run('paid', id);
  res.json({ success: true });
});

app.post('/api/admin/withdrawals/:id/reject', verifyAdmin, (req, res) => {
  const id = req.params.id;
  const w = db.prepare('SELECT * FROM withdrawals WHERE id = ?').get(id);
  if (!w) return res.status(404).json({ error: 'not found' });
  if (w.status !== 'pending') return res.status(400).json({ error: 'can only reject pending withdrawals' });

  const tx = db.transaction(() => {
    db.prepare('UPDATE withdrawals SET status = ? WHERE id = ?').run('rejected', id);
    db.prepare('UPDATE users SET balance = balance + ? WHERE id = ?').run(w.amount, w.user_id);
  });

  try {
    tx();
    res.json({ success: true });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: 'server error' });
  }
});

app.get('/api/admin/users', verifyAdmin, (req, res) => {
  const rows = db.prepare('SELECT id, username, invite_code, referrer_id, balance, created_at FROM users ORDER BY created_at DESC').all();
  res.json({ users: rows });
});

